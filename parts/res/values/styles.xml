<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.XiaomiParts" parent="Theme.SubSettingsBase">
        <item name="android:windowBackground">@drawable/main_background</item>
        <item name="android:statusBarColor">@color/gradient_start</item>
        <item name="android:navigationBarColor">@color/gradient_start</item>
        <item name="android:colorPrimary">@color/accent_color</item>
        <item name="android:colorAccent">@color/accent_color</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.SubSettingsBase.Glassmorphism" parent="Theme.SubSettingsBase">
        <item name="android:windowBackground">@drawable/main_background</item>
        <item name="android:statusBarColor">@color/gradient_start</item>
        <item name="android:navigationBarColor">@color/gradient_end</item>
        <item name="android:colorPrimary">@color/accent_color</item>
        <item name="android:colorAccent">@color/accent_color</item>
        <item name="preferenceCategoryStyle">@style/PreferenceCategory.Glassmorphism</item>
        <item name="switchStyle">@style/Widget.Switch.Glassmorphism</item>
    </style>

    <style name="PreferenceCategory.Glassmorphism" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_glass</item>
    </style>

    <style name="Widget.Switch.Glassmorphism" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="trackTint">@color/switch_track_on</item>
        <item name="thumbTint">@color/accent_color</item>
    </style>

    <style name="CardView.Glassmorphism" parent="CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.CategoryTitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/accent_color</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextAppearance.PreferenceTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PreferenceSummary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>